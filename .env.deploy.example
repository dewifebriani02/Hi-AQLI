# ==============================================================================
# Konfigurasi Deploy Hi-AQLI -> VPS (Contoh / Template)
# ==============================================================================
# Salin file ini menjadi `.env.deploy` di root repositori (otomatis di-ignore git):
#   cp .env.deploy.example .env.deploy
#   chmod 600 .env.deploy
#
# Jika belum memiliki `scripts/deploy.sh` lokal:
#   cp scripts/deploy.example.sh scripts/deploy.sh
#   chmod +x scripts/deploy.sh
#
# PENTING: Jangan pernah commit `.env.deploy` atau kredensial asli ke git.
# ==============================================================================

# Hostname atau IP publik VPS tujuan (wajib)
VPS_IP='203.0.113.10'

# User SSH di VPS (wajib)
SSH_USER='deploy_user'

# Path absolut direktori aplikasi di VPS (wajib)
REMOTE_PATH='/home/deploy_user/htdocs/hiaqli.pro'

# Port internal tempat Next.js dijalankan oleh PM2 (wajib)
APP_PORT='3001'

# Domain publik untuk health check pasca-deploy (opsional, default: hiaqli.pro)
APP_DOMAIN='hiaqli.pro'

# Nama proses aplikasi di PM2 (opsional, default: hiaqli-app)
PM2_APP_NAME='hiaqli-app'

# Path ke private key SSH spesifik (opsional; kosongkan untuk memakai default ~/.ssh / ssh-agent)
# SSH_KEY_PATH="$HOME/.ssh/id_ed25519"

# Direktori upload persisten di luar REMOTE_PATH (opsional tapi disarankan).
# Jika diaktifkan, skrip deploy otomatis memastikan direktori ini tersedia di VPS,
# menyalin isi lama `public/uploads/` (bila masih direktori biasa), lalu membuat
# symlink `public/uploads -> $UPLOADS_DIR` agar file upload terpisah dari pohon kode.
# UPLOADS_DIR='/home/deploy_user/hiaqli-uploads'

# ------------------------------------------------------------------------------
# FALLBACK TRANSISI (TIDAK DISARANKAN): Password SSH via sshpass
# ------------------------------------------------------------------------------
# Secara default skrip memakai autentikasi SSH key. Variabel SSH_PASS hanya
# disediakan agar masa transisi ke SSH key tidak memutus alur deploy.
# Segera pasang SSH key (`ssh-keygen -t ed25519` & `ssh-copy-id`), lalu hapus
# atau kosongkan SSH_PASS di `.env.deploy` dan rotasi password lama di VPS.
# SSH_PASS=''
