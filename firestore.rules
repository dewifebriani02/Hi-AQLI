
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_superadmin/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && (exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) || isSuperAdmin());
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /tikrar_registrations/{registrationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /donations/{donationId} {
      // Izinkan list jika filternya adalah userId milik sendiri atau user adalah admin
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /roles_admin/{userId} {
      allow read: if isSignedIn();
      // Bootstrap: Izinkan email khusus untuk membuat entry admin miliknya sendiri
      allow create, update: if isAdmin() || (request.auth.token.email == "dewifebriani@gmail.com" && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /roles_superadmin/{userId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /{path=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
