
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the AQLI Digital application, storing core profile information.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "username": {
          "type": "string",
          "description": "The user's chosen username, used for login and display."
        },
        "email": {
          "type": "string",
          "description": "The user's email address, used for communication and account recovery.",
          "format": "email"
        },
        "profilePictureUrl": {
          "type": "string",
          "description": "URL to the user's profile picture, if available.",
          "format": "uri"
        },
        "roleId": {
          "type": "string",
          "description": "Reference to the user's assigned role, defining permissions and access levels. (Relationship: Role 1:N User)"
        },
        "isTikrarPaid": {
          "type": "boolean",
          "description": "Flag indicating if the user has paid for the premium Tikrar Daily program."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the user account was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when the user account was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "username",
        "email",
        "roleId",
        "createdAt",
        "updatedAt"
      ]
    },
    "TikrarRegistration": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TikrarRegistration",
      "type": "object",
      "description": "Records a user's registration for the Tikrar Daily premium program.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the registration."
        },
        "userId": {
          "type": "string",
          "description": "Reference to the registered user."
        },
        "batchName": {
          "type": "string",
          "description": "The name of the batch joined (e.g., 'BATCH 1')."
        },
        "whatsapp": {
          "type": "string",
          "description": "User's WhatsApp number for coordination."
        },
        "amount": {
          "type": "number",
          "description": "Total amount paid including unique code."
        },
        "paymentMethod": {
          "type": "string",
          "description": "Method used for payment (transfer, qris)."
        },
        "status": {
          "type": "string",
          "description": "Registration status (pending_verification, active, expired)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "batchName",
        "whatsapp",
        "amount",
        "status",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "User profiles. Accessible only by the user themselves and admins."
        }
      },
      {
        "path": "/tikrar_registrations/{registrationId}",
        "definition": {
          "entityName": "TikrarRegistration",
          "schema": {
            "$ref": "#/backend/entities/TikrarRegistration"
          },
          "description": "Tikrar Daily program registrations. Users can read/write their own registrations."
        }
      },
      {
        "path": "/donations/{donationId}",
        "definition": {
          "entityName": "Donation",
          "schema": {
            "$ref": "#/backend/entities/Donation"
          },
          "description": "General donations."
        }
      }
    ]
  }
}
