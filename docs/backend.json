
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the HI AQLI application.",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "roleId": { "type": "string" },
        "isTikrarPaid": { "type": "boolean" },
        "paidJuz": { "type": "number" },
        "tikrarLevel": { "type": "number" },
        "followedHalaqahs": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "List of Study Circle IDs the user has verified access to."
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username", "email", "roleId", "createdAt", "updatedAt"]
    },
    "Halaqah": {
      "title": "Halaqah",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "muallimah": { "type": "string", "description": "Nama Mu'allimah pengampu" },
        "muallimahId": { "type": "string" },
        "musyrifah": { "type": "string", "description": "Nama Musyrifah pendamping" },
        "musyrifahId": { "type": "string" },
        "description": { "type": "string" },
        "schedule": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "durationWeeks": { "type": "number", "description": "Durasi dalam pekan" },
        "level": { "type": "string" },
        "isPremium": { "type": "boolean" },
        "hasExam": { "type": "boolean" },
        "hasCertificate": { "type": "boolean" },
        "tag": { "type": "string" },
        "basePrice": { "type": "number" },
        "quota": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "muallimah", "level"]
    },
    "PageExamRequest": {
      "title": "PageExamRequest",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "page": { "type": "number" },
        "juz": { "type": "number" },
        "status": { "type": "string", "enum": ["requested", "scheduled", "passed", "failed"] },
        "requestedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "page", "status", "requestedAt"]
    },
    "HalaqahRegistration": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "HalaqahRegistration",
      "type": "object",
      "description": "Records a user's registration for any study circle program.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "halaqahId": { "type": "string" },
        "halaqahTitle": { "type": "string" },
        "isPaid": { "type": "boolean" },
        "whatsapp": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "level": { "type": "number" },
        "targetJuz": { "type": "number" },
        "senderName": { "type": "string" },
        "proofFileName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_verification", "active", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "halaqahId", "status", "createdAt"]
    },
    "Role": {
      "type": "object",
      "properties": {
        "userId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "User profiles."
        }
      },
      {
        "path": "/halaqahs/{halaqahId}",
        "definition": {
          "entityName": "Halaqah",
          "schema": { "$ref": "#/backend/entities/Halaqah" },
          "description": "Program and classes list."
        }
      },
      {
        "path": "/page_exams/{examId}",
        "definition": {
          "entityName": "PageExamRequest",
          "schema": { "$ref": "#/backend/entities/PageExamRequest" },
          "description": "Requests for page-wide oral exams."
        }
      },
      {
        "path": "/halaqah_registrations/{registrationId}",
        "definition": {
          "entityName": "HalaqahRegistration",
          "schema": { "$ref": "#/backend/entities/HalaqahRegistration" },
          "description": "Halaqah program registrations."
        }
      },
      {
        "path": "/roles_admin/{userId}",
        "definition": {
          "entityName": "Role",
          "schema": { "$ref": "#/backend/entities/Role" },
          "description": "Admin access control."
        }
      },
      {
        "path": "/donations/{donationId}",
        "definition": {
          "entityName": "Donation",
          "schema": { "type": "object" },
          "description": "General donations."
        }
      }
    ]
  }
}
